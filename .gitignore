# Data directories (keep folder structure via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment variables & secrets
.env
*.env

# Python & Jupyter caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# macOS system files & Office temporary locks
.DS_Store
**/.DS_Store
~$*
*.tmp

# LaTeX intermediate build artifacts
*.aux
*.bbl
*.blg
*.lof
*.log
*.lot
*.out
*.toc
texput.log
*.fls
*.fdb_latexmk
*.synctex.gz

# Logs & Docker volumes
logs/
airflow_logs/
pgdata/
pgadmin_data/

# Excluded Non-Core Assets & Administrative Docs
notebooks/
docs/proposal/
docs/presentation/
docs/I4_Internship I_FollowUp/
docs/I4_Request Defense Approval AMS/
docs/senoir.pdf
docs/i4_thesis_report/
mindmap/

# IDE & Editor configs
.agents/
.idea/
.vscode/
