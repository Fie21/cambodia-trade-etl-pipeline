# Copy this file to .env before running docker compose up.
# On Linux, set this to your host user id (run `id -u`) so mounted volumes
# (dags/, src/, data/, logs/) aren't owned by root. On macOS/Windows Docker
# Desktop the default works fine as-is.
AIRFLOW_UID=50000

# GDCE Cambodia Statistics Portal Settings
GDCE_BASE_URL=https://stats.customs.gov.kh
GDCE_API_TOKEN=fHs4RbfpSE57qfYM

# Database Credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

