    // =========================================================================                                       
    // Cambodia GDCE Transport Data Warehouse Schema (PostgreSQL 16)                                                   
    // Project: Automated Cambodia Trade ETL Pipeline & Analytics Platform                                             
    // =========================================================================                                       
                                                                                                                       
    // --- TIER 1: STAGING LAYER (Audit & Ingestion) ---------------------------                                       
    Table "staging.raw_transportation_stats" [headercolor: #0F766E] {                                                  
      date date [pk, note: "Calendar ingest date (YYYY-MM-01)"]                                                        
      period varchar [note: "e.g. '2024-01'"]                                                                          
      raw_payload jsonb [note: "Verbatim GDCE JSON API payload snapshot"]                                              
      scraped_at timestamptz [default: `now()`, note: "Ingestion timestamp"]                                           
                                                                                                                       
      Note: "Tier-1 Bronze Layer: Immutable audit landing zone"                                                        
    }                                                                                                                  
                                                                                                                       
                                                                                                                       
    // --- TIER 2: WAREHOUSE LAYER (Fact & Analytics Modeling) ------------------                                      
    Table "warehouse.fact_transportation_stats" [headercolor: #1D4ED8] {                                               
      date date [pk, note: "Temporal reference key"]                                                                   
      regime varchar [pk, note: "Customs regime: 'Import' or 'Export'"]                                                
      description varchar [pk, note: "Transport mode: 'Sea transport', 'Air transport'"]                               
      period varchar [note: "Monthly trade period (YYYY-MM)"]                                                          
      description_kh text [note: "Khmer official terminology (e.g. ការដឹកជញ្ជូនតាមផ្លូវសមុទ្រ)"]                                   
      net_weight_ton double [note: "Normalized Metric Tons (net_weight_kg / 1000.0)"]                                  
      net_weight_kg double [note: "Raw customs kilograms"]                                                             
      value_usd double [note: "Standardized Trade Value in USD ($)"]                                                   
      value_khr bigint [note: "Official Trade Value in Cambodian Riel (៛)"]                                            
      loaded_at timestamptz [default: `now()`, note: "Warehouse load timestamp"]                                       
                                                                                                                       
      indexes {                                                                                                        
        (date, regime, description) [pk]                                                                               
      }                                                                                                                
                                                                                                                       
      Note: "Tier-2 Gold Layer: Central fact table queried directly by Streamlit dashboard"                            
    }                                                                                                                  
                                                                                                                       
                                                                                                                       
    // --- REFERENCE DIMENSIONS (Lookup & Mappings) ----------------------------                                       
    Table "ref.dim_transport_mode" [headercolor: #475569] {                                                            
      description varchar [pk, note: "Primary modal description"]                                                      
      description_kh text [note: "Khmer modal translation"]                                                            
      category varchar [note: "Classification: 'Maritime', 'Air', 'Land'"]                                             
      icon varchar [note: "Display emoji: 🚢, ✈️, 🚛, 🚆, 📦"]                                                         
      is_active boolean [default: true]                                                                                
    }                                                                                                                  
                                                                                                                       
    Table "ref.dim_trade_regime" [headercolor: #475569] {                                                              
      regime_code varchar [pk, note: "Official customs code: 'IM', 'EX,RX'"]                                           
      regime_name varchar [note: "Standard regime: 'Import', 'Export'"]                                                
      regime_name_kh text [note: "Khmer translation: ការនាំចូល, ការនាំចេញ"]                                                    
      flow_type varchar [note: "Cargo direction: 'Inbound', 'Outbound'"]                                               
    }                                                                                                                  
                                                                                                                       
    Table "ref.dim_date" [headercolor: #475569] {                                                                      
      date date [pk, note: "First day of month (YYYY-MM-01)"]                                                          
      period varchar [note: "Period code (YYYY-MM)"]                                                                   
      year integer [note: "Four-digit calendar year (2016-2026)"]                                                      
      month integer [note: "Month index (1-12)"]                                                                       
      quarter varchar [note: "Financial quarter: 'Q1', 'Q2', 'Q3', 'Q4'"]                                              
    }                                                                                                                  
                                                                                                                       
                                                                                                                       
    // --- AUDIT & ORCHESTRATION LAYER -----------------------------------------                                       
    Table "warehouse.etl_run_log" [headercolor: #BE185D] {                                                             
      id serial [pk, note: "Auto-incrementing audit log identifier"]                                                   
      dag_run_id varchar [note: "Apache Airflow DAG execution ID"]                                                     
      data_interval_start date [note: "Batch start period date"]                                                       
      data_interval_end date [note: "Batch end period date"]                                                           
      rows_loaded integer [note: "Total records successfully upserted"]                                                
      status varchar [note: "Execution state: 'success' or 'failed'"]                                                  
      logged_at timestamptz [default: `now()`, note: "Telemetry recording timestamp"]                                  
    }                                                                                                                  
                                                                                                                       
                                                                                                                       
    // --- LOGICAL & PHYSICAL RELATIONSHIPS ------------------------------------                                       
    // 1. ETL Pipeline Ingestion Flow                                                                                  
    Ref: "staging.raw_transportation_stats".date < "warehouse.fact_transportation_stats".date                          
                                                                                                                       
    // 2. Conformed Dimension Lookups (1 : N)                                                                          
    Ref: "warehouse.fact_transportation_stats".description > "ref.dim_transport_mode".description                      
    Ref: "warehouse.fact_transportation_stats".regime > "ref.dim_trade_regime".regime_name                             
    Ref: "warehouse.fact_transportation_stats".date > "ref.dim_date".date                                              
                                                                                                                       
    // 3. Airflow Telemetry Logging Link                                                                               
    Ref: "warehouse.fact_transportation_stats".date - "warehouse.etl_run_log".data_interval_start                      
                                                                                                                       
                                                                                                                       
    // --- TABLE GROUPS (ZONES) ------------------------------------------------                                       
    TableGroup tier_1_staging {                                                                        
      "staging.raw_transportation_stats"                                                                               
    }                                                                                                                  
                                                                                                                       
    TableGroup tier_2_warehouse {                                                                    
      "warehouse.fact_transportation_stats"                                                                            
    }                                                                                                                  
                                                                                                                       
    TableGroup reference_dimensions {                                                                                
      "ref.dim_transport_mode"                                                                                         
      "ref.dim_trade_regime"                                                                                           
      "ref.dim_date"                                                                                                   
    }                                                                                                                  
                                                                                                                       
    TableGroup audit_and_telemetry {                                                                                   
      "warehouse.etl_run_log"                                                                                          
    } 
